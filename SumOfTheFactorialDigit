class SumOfTheFactorialDigit{
    public static void main(String[] args)
    {
        int num=323;
        int digit;
        int factorial=1;
        int sum=0;
        while(num>0)
        {
            digit=num%10;
            for(int i=1;i<=digit;i++)
            {
                factorial=factorial*i;
            }
            sum=sum+factorial;
            num=num/10;
        }
        System.out.println(sum);
    }
}
