class ExponenoalValueOfEachDigitToThePowerCountNumberOfDigits{
    public static void main(String[] args)
    {
        int number=567;
        int count=0;
        int temp=number;
        while(number>0)
        {
           count++;
           number/=10;
        }
        while(temp>0)
        {
            int digits=temp%10;
            int result=1;
            for(int i=1;i<=count;i++)
            {
                result=result*digits;
            }
            System.out.println(digits+"^"+count+"="+result);
            temp=temp/10;
        }
    }
}
