//Product Of the given number is Prime or Not
class Product{
    public static void main(String[] args)
    {
        int n=30;
        int product=1;
        for(int i=1;i<=n;i++)
        {
            if(n%i==0)
            {
                product=product*i;
            }
        }
       System.out.println(product);
    }
}
