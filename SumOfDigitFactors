import java.util.Scanner;

class SumOfDigitFactors {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        int totalSum = 0;

        while (num > 0) {
            int digit = num % 10;

            for (int i = 1; i <= digit; i++) {
                if (digit % i == 0) {
                    totalSum += i;
                }
            }
            num = num / 10;
        }

        System.out.println(totalSum);
    }
}
