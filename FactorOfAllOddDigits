import java.util.Scanner;

class FactorOfAllOddDigits {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int num = sc.nextInt();
        while (num > 0) {
            int digit = num % 10;

            for (int i = 1; i <= digit; i++) {
                if (digit % i == 0 && i % 2 != 0) {
                    System.out.print(i+" ");
                }
            }
            num = num / 10;
        }
        sc.close();
    }
}
